# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Postgres the API connects to at runtime (Neon pooled endpoint). The login role must be able to
# SET ROLE invoiceflow_app (migration 0003 grants this to the role that runs migrations).
# In staging/production use a separate non-owner login role (DATABASE_ERD.md §1.1).
# sslmode=verify-full keeps today's strict certificate checking in future pg versions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Direct (non-pooled) endpoint, used by migrations only.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Disposable database for integration tests. ALL DATA IN IT IS DELETED by the tests.
# Leave unset to skip integration tests.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/invoiceflow_test?sslmode=verify-full

# Firebase Authentication (ADR-0002). Sign-in is disabled until this is set.
FIREBASE_PROJECT_ID=
# Optional: path to a service-account JSON. Needed for logout (revoking sessions) and
# revocation checks. Keep the file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
