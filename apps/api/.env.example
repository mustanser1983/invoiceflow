# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Neon pooled connection string (used by the API at runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/invoiceflow?sslmode=require

# Neon direct (non-pooled) connection string (used by migrations only)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/invoiceflow?sslmode=require
